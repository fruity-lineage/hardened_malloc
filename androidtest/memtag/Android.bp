cc_test {
    name: "memtag_test",
    enabled: select((
        arch(),
        product_variable("use_hardened_malloc"),
        product_variable("device_has_arm_mte"),
    ), {
        ("arm64", true, true): true,
        (default, default, default): false,
    }),
    srcs: ["memtag_test.cc"],
    header_libs: ["bionic_libc_platform_headers"],
    cflags: [
        "-D_GNU_SOURCE",
        "-Wall",
        "-Werror",
        "-Wextra",
        "-O0",
        "-march=armv9-a+memtag",
    ],

    compile_multilib: "64",

    sanitize: {
        memtag_heap: true,
    },
}
