java_test_host {
    name: "HMallocTest",
    enabled: select((
        product_variable("device_primary_arch"),
        product_variable("use_hardened_malloc"),
        product_variable("device_has_arm_mte"),
    ), {
        ("arm64", true, true): true,
        (default, default, default): false,
    }),
    target: {
        windows: {
            enabled: false,
        },
    },
    srcs: [
        "src/**/*.java",
    ],

    libs: [
        "tradefed",
        "compatibility-tradefed",
        "compatibility-host-util",
    ],

    static_libs: [
        "cts-host-utils",
        "frameworks-base-hostutils",
    ],

    test_suites: [
        "general-tests",
    ],

    data_device_bins_64: [
        "memtag_test",
    ],
}
